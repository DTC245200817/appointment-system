# ==============================================================================
# HỆ THỐNG ĐẶT LỊCH HẸN / APPOINTMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Configuration
NODE_ENV=production
PORT=3000

# PostgreSQL Superuser (dùng cho quản trị hệ thống và pgAdmin)
POSTGRES_DB=appointment_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=StrongAdminP@ssw0rd_Postgres_2026!
POSTGRES_PORT=5432

# PostgreSQL Application User (Least Privilege - chỉ quyền CRUD trên bảng nghiệp vụ)
APP_DB_USER=appointment_user
APP_DB_PASSWORD=SecureAppPass_2026!

# Database Connection (Container nội bộ)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=appointment_db
DB_USER=appointment_user
DB_PASSWORD=SecureAppPass_2026!

# pgAdmin 4 Management UI
PGADMIN_DEFAULT_EMAIL=admin@appointment.com
PGADMIN_DEFAULT_PASSWORD=AdminPgAdminP@ss_2026!
PGADMIN_PORT=5050

# Nginx Reverse Proxy Ports
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Prometheus Monitoring
PROMETHEUS_PORT=9090

# Grafana Dashboard
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=GrafanaAdminP@ss_2026!
GRAFANA_PORT=3001

# Loki Log Server
LOKI_PORT=3100

# Admin Portal Authentication (Bảo mật tài khoản quản trị)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@2026!
ADMIN_JWT_SECRET=medschedule_secure_secret_token_key_2026!
